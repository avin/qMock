{
  "compilerOptions": {
    "target": "ES2023", "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext", "moduleResolution": "Bundler", "jsx": "react-jsx",
    "strict": true, "skipLibCheck": true, "noEmit": true,
    "allowSyntheticDefaultImports": true, "types": ["vite/client", "node"],
    "paths": { "@ui/*": ["./ui/*"], "@catalog": ["./src/overrideCatalog.ts"] }
  },
  "include": ["ui", "src/overrideCatalog.ts", "src/utils.ts"]
}
